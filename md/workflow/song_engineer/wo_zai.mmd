        P7_1 --> P7_2
        P7_2 --> final["🎵 走在.mp3<br/>成品音频"]
    end

    %% ========== 阶段连接 ==========
    Phase1 -->|"参考分析产出"| Phase2
    Phase2 -->|"和弦骨架+吉他"| Phase3
    Phase3 -->|"歌词+音素"| Phase4
    Phase4 -->|"旋律表"| Phase5
    Phase5 -->|"人声WAV轨道"| Phase6
    Phase6 -->|"多轨WAV"| Phase7

    %% ========== 决策节点 ==========
    D1{"OpenUTAU<br/>渲染?"}
    D2{"MiniMax<br/>AI生成?"}

    Phase5 --> D1
    D1 -->|"渲染WAV"| Phase6
    Phase7 --> D2
    D2 -->|"AI人声"| Phase6

    %% 样式应用
    class P1_1,P1_2,P1_3 phase1
    class P2_1,P2_2 phase2
    class P3_1,P3_2 phase3
    class P4_1,P4_2 phase4
    class P5_1,P5_2,P5_3 phase5
    class G1,G2,G3,G4,G5,V1,V2,V3,A1,A2,A3,A4,P6_1,full phase6
    class P7_1,P7_2,final phase7
    class O1_1,O1_2,O1_3,O1_4,O2_1,O2_2,O2_3,O3_1,O3_2,O4_1,O4_2,O5_1,O5_2,O5_3 output
    class D1,D2 decision
