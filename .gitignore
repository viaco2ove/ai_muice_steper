# ===========================================
# AI 音乐助手项目 .gitignore
# ===========================================

# ---------- Python ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- 环境与密钥 ----------
.env
.env.local
.env.*.local
*.key
*.pem

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---------- workspace 运行时产物 ----------
# workspace 是各技能的输出目录,产物(wav/mid/mp3/csv 等)可重生,不入库
# 用 workspace/* 忽略内容但保留目录本身(配合 .gitkeep)
# 若需保留某首歌的创作数据,用 git add -f 强制添加
workspace/*
!workspace/.gitkeep

# ---------- 音频/MIDI 二进制产物(任何位置) ----------
*.wav
*.mp3
*.mid
*.midi
*.flac
*.ogg
*.aac
*.sf2
*.sf3

# 但保留技能目录里的示例/测试用小文件(如有需要用 -f 强制加)
# 注意:SoundFont(.sf2/.sf3)很大,绝不入库

# ---------- 数据产物 ----------
*.csv
# 例外:md 目录下的 csv 是知识库数据,需保留
!md/**/*.csv

# ---------- 临时文件 ----------
_*.md
_*.py
_*.txt
_test*
*.tmp
*.bak
*.log

# ---------- 模型缓存 ----------
# basic_pitch/demucs 模型缓存
*.onnx
*.tflite
*.mlmodel
torch/
cache/
